# Copy to .env.local for local development. Never commit real values.

# ── AutomotiveAI gateway (server-only) ────────────────────────────────────────
# Base URL of the AutomotiveAI gateway that serves /api/motology/*.
# Only read by Next.js route handlers and server components; never exposed to
# the browser (do NOT prefix with NEXT_PUBLIC_).
MOTOLOGY_GATEWAY_URL=http://localhost:8080

# Shared secret sent as the X-Motology-Key header. Server-only.
MOTOLOGY_API_KEY=replace-me

# ── Public ────────────────────────────────────────────────────────────────────
# This app's public URL (used for metadata / Open Graph links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional links to the privacy policy and terms (shown in the footer and on
# the consent form). Empty hides the link. Baked in at build time.
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
